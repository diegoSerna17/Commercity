{
  "name": "commercity",
  "version": "1.3.1",
  "description": "CommerCity - Marketplace Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.commercity.app",
    "productName": "CommerCity",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
