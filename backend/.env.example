# ---------------------------------------------------------------------------
# CommerCity - Backend (.env.example)
# Copiar a `.env` y completar con valores locales. NUNCA versionar `.env`.
# ---------------------------------------------------------------------------

# Servidor / entorno
PORT=3000
# development | test | production. Vitest corre con NODE_ENV=test.
NODE_ENV=development

# Base de datos MySQL (ver src/server/config/db.js)
DB_HOST=localhost
DB_PORT=3306
# NO usar `root`: cree un usuario dedicado con permisos solo sobre esta BD.
DB_USER=commercity_app
DB_PASSWORD=
DB_NAME=commercity_v2

# Seguridad
# JWT_SECRET: OBLIGATORIO, aleatorio, >= 32 caracteres y distinto de
# CRYPTO_SECRET_KEY. El servidor NO arranca sin el (ver src/server/utils/config.js).
# Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# CRYPTO_SECRET_KEY: clave PROPIA (aleatoria, distinta de JWT_SECRET) para
# cifrar datos sensibles (cuenta bancaria, RF76). En produccion es obligatoria;
# en desarrollo, si se omite, se deriva de JWT_SECRET como respaldo.
CRYPTO_SECRET_KEY=

# CORS / enlaces del frontend (ver src/server/app.js y usuarios.controllers.js)
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWLIST: origenes ADICIONALES permitidos, separados por coma.
# Vacio = solo FRONTEND_URL (+ localhost/Capacitor fuera de produccion).
CORS_ALLOWLIST=
# ALLOW_DESKTOP_ORIGINS=true habilita origenes de escritorio/movil empaquetado
# (null, file://). Cerrado por defecto: solo activarlo en desarrollo o en un
# entorno controlado (M-16/H6).
ALLOW_DESKTOP_ORIGINS=false
# TRUST_PROXY: hops de proxy inverso de confianza para express (rate limit por IP
# real). Ej: 1 detras de un solo proxy; vacio = sin proxy (M-9/H7).
TRUST_PROXY=

# Correo transaccional (Resend, ver src/server/utils/mailer.js).
# Sin RESEND_API_KEY el mailer entra en modo simulacion (solo consola).
RESEND_API_KEY=
RESEND_FROM=CommerCity <onboarding@resend.dev>
