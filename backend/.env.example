# ---------------------------------------------------------------------------
# CommerCity - Backend (.env.example)
# Copiar a `.env` y completar con valores locales. NUNCA versionar `.env`.
# ---------------------------------------------------------------------------

# Servidor
PORT=3000

# Base de datos MySQL (ver src/server/config/db.js)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=commercity

# Seguridad
# El servidor NO arranca sin JWT_SECRET (ver src/server/utils/config.js).
# Generar uno aleatorio, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_largo
# Clave para cifrar datos sensibles (cuenta bancaria, RF76).
# Si se omite, se usa JWT_SECRET como respaldo.
CRYPTO_SECRET_KEY=

# CORS / enlaces del frontend (ver src/server/app.js y usuarios.controllers.js)
FRONTEND_URL=http://localhost:5173

# Correo transaccional (Resend, ver src/server/utils/mailer.js).
# Sin RESEND_API_KEY el mailer entra en modo simulacion (solo consola).
RESEND_API_KEY=
RESEND_FROM=CommerCity <onboarding@resend.dev>
