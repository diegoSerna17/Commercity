# Copiar este archivo como .env y reemplazar los valores con los del entorno real.
# NO subir .env al repositorio (esta ignorado por .gitignore).
PORT=3000
NODE_ENV=development

# ── MySQL ────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=commercity

# ── Seguridad (OBLIGATORIO) ─────────────────────────
# JWT_SECRET es obligatorio: el servidor NO arranca sin el.
# NO lo envia el lider de BD (Meneses): cada integrante genera el suyo en su .env local.
# Generar uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Clave de cifrado de datos bancarios (RNF11). Si no se define, se deriva de JWT_SECRET.
# Recomendado: generar una de 32 bytes con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_SECRET_KEY=

# ── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Correo (Resend) ─────────────────────────────────
# Sin API key el correo de recuperacion se simula en consola (modo dev).
RESEND_API_KEY=
RESEND_FROM=CommerCity <onboarding@resend.dev>
