        <mxCell id="p3-7" edge="1" parent="1" style="html=1;endArrow=block;startArrow=none;dashed=0;fontSize=11;curved=0;rounded=0;" value="1. EVERY 1 DAY, STARTS 2026-08-08 02:00:00 -&gt; dispara el EVENT limpiar_carritos_inactivos (ON COMPLETION PRESERVE)">
