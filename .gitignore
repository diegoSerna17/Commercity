# ---------------------------------------------------------------------------
# Exclusions propias del proyecto CommerCity
# (regla limpieza-archivos-temporales.md)
# ---------------------------------------------------------------------------

# Imagenes y adjuntos subidos por los usuarios en tiempo de ejecucion:
# no son fuente, son datos de la instalacion local.
backend/src/server/uploads/

# Logs y salidas de diagnostico de informes (temporales consumidos)
informes/_*

# Scripts temporales de consulta/diagnostico contra la BD
backend/_*.mjs

# Cache local de Vitest/Vite dentro de backend (si quedo rastreada por error)
backend/node_modules/.vite/

# Payload crudo del set E2E: contiene respuestas reales de la BD compartida
# (listados de usuarios con nombres y correos). NO versionar.
AVANCES/PRUEBAS/resultados.json

# ---------------------------------------------------------------------------
# Regla 2026-09-24: solo se suben archivos FUNCIONALES DE EJECUCIÓN.
# Quedan FUERA: entregas parciales compañeros, informes entregables,
#             documentación de módulos no integrados, binarios locales.
# ---------------------------------------------------------------------------

# Entregas de compañeros NO integradas en trunk (móvil, escritorio, chat,
# proyecto Diego, scripts, drives, carpetas historicas, meneses, last version,
# audios, docs paralelos, TES). Líder define si entran en carpetas paralelas
# en otro repositorio o en ramas separadas.
AVANCES/
DRIVE/
Meneses/
"LAST VERSION"/
Audios/
docs/*
# Excepción aprobada 2026-09-27 (Daniel), corregida 2026-10-11 (M-GIT-1): las
# excepciones nominadas PLAN_INTEGRACION_*, INFORME_RAMA_*, EVIDENCIA_E2E_*,
# INFORME_ESTADO_* e INFORME_FINAL_SENA_* se retiraron porque esos archivos ya
# no existen en el arbol: una excepcion de archivo inexistente no versiona nada
# y solo obligaba a recordar `git add -f`. El resto de docs/ sigue fuera.
!docs/informes/
docs/informes/*
# Informes de auditoria de PREVIEW que SI se versionan (los del plan de remediacion):
!docs/informes/INFORME_AUDITORIA_PREVIEW_*.md
!docs/informes/INFORME_REAUDITORIA_PREVIEW_*.md
# Excepción aprobada 2026-10-08 (Daniel): se versiona la documentacion
# tecnica generada desde Zod/OpenAPI (plan docs-api). El resto de docs/ sigue fuera.
!docs/api/
!docs/api/**
!docs/bd/
!docs/bd/**
!docs/guias/
!docs/guias/**
!docs/arquitectura.md
!docs/CHANGELOG.md
# Excepción 2026-10-11 (M-GIT-1): docs/DRIVE ya esta versionado (315 archivos,
# 32,5 MB; sus rutas largas rompen el checkout en Windows). Se un-ignora para
# que su mantenimiento no dependa de `git add -f`.
!docs/DRIVE/
!docs/DRIVE/**
scripts/
# Excepcion 2026-10-08: generador OpenAPI versionado (plan docs-api).
!backend/scripts/
!backend/scripts/gen-openapi.mjs
!backend/scripts/gen-entidades.mjs
TES.MD
INFORME_CALIDAD*.pdf
INFORME_CALIDAD*.PDF

# Informes .docx (versiones v4, v6, Final, 3.0, optimizado, Sugerencias)
# ya convertidos o con equivalente .md: NO se versionan como fuente.
informes/*.docx
informes/**/*.docx
informes/**/*.DOCX

# Informes generados NUEVOS en .md que son entregables, no parte del
# código ejecutable (decisión Daniel 2026-09-24). Quedan en el repo solo
# si el líder los aprueba explícitamente en un commit específico.
# (Dejar comentado para activar/desactivar por lote):
# informes/EVIDENCIA_E2E_ENDPOINTS_*.md
# informes/INFORME_CALIDAD_COMMERCITY_*.md

# Entornos locales del desarrollador (Claude, Trae, Kilo, Continue, OpenCode):
# NUNCA entran al repo.
.trae/
.kilo/
.continue/
opencode.jsonc
skills-lock.json

# Cache rebuildable de graphify + dotfiles con rutas absolutas locales.
# El entregable versionado es: graph.html, graph.json, GRAPH_REPORT.md,
# manifest.json, cost.json, .graphify_labels.json y memory/.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root

# Carpetas caches de Vite/Vitest de todo el arbol (raíz + backend + frontend):
**/.vite/

# Uploads de runtime en cualquier profundidad:
**/uploads/

# PDFs, archivos grandes binarios de presentaciones o entregas:
*.pptx
*.ppsx
*.mp3
*.mp4
*.wav
*.zip
*.rar
*.7z

# Archivos Windows del perfil:
*.lnk
*.url

# ---------------------------------------------------------------------------
# apps/: snapshot trackeable de las apps movil/escritorio (aprobado 2026-09-28).
# Fuente funcional; NUNCA llaves de firma, SDKs locales ni artefactos de build.
# Regenerables: android/app/src/main/assets/public -> npx cap sync android
# ---------------------------------------------------------------------------
**/*.keystore
apps/movil/android/local.properties
apps/movil/android/.gradle/
apps/movil/android/app/src/main/assets/public/
